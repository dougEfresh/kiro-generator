[Unit]
Description=Watch kiro config for %I

[Path]
PathChanged=%I/.kiro/generators/manifests
PathChanged=%I/.kiro/generators/agents
PathChanged=%h/.kiro/generators/manifests
PathChanged=%h/.kiro/generators/agents
TriggerLimitIntervalSec=5s
TriggerLimitBurst=3

[Install]
WantedBy=graphical-session.target
