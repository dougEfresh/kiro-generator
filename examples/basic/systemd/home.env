# kg home environment — applied to kiro-generator.service ($HOME agents)
# see kg generate --help for all options
KG_NOTIFY=true

# Enable debug logging (visible in journalctl)
#KG_DEBUG=true

# Output format: table, json, text
#KG_FORMAT=plain

# Color output: always, auto, never
#KG_COLOR=auto

# Run diff after generation
#KG_DIFF=true

# Force regeneration even if nothing changed
#KG_FORCE=true
